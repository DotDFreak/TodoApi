<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Ignore machine-wide private feeds (Azure DevOps, GitHub Packages) for this
         warmup project. <clear/> drops inherited sources; only nuget.org remains,
         which is public and needs no login. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
